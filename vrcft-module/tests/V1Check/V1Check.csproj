<Project Sdk="Microsoft.NET.Sdk">
  <!-- Evaluates VRCFaceTracking's own v1 (legacy SRanipal) parameter functions for given
       Unified Expression weights. Used to check that Pal Buddy Guy's targets reproduce the
       intended v1 parameter values. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VRCFTSource)\VRCFaceTracking.Core\VRCFaceTracking.Core.csproj" />
  </ItemGroup>
</Project>
