<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal stand-in for the VRCFaceTracking app: spawns the real VRCFT module process
       with a module, speaks the sandbox IPC protocol and prints the tracking state. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VRCFTSource)\VRCFaceTracking.Core\VRCFaceTracking.Core.csproj" />
  </ItemGroup>
</Project>
