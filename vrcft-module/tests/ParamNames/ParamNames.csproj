<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lists every avatar parameter base name VRCFaceTracking can drive (v1, v2, eye, head,
       native), used to generate palbuddy/vrcft_names.py for the name-clash check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VRCFTSource)\VRCFaceTracking.Core\VRCFaceTracking.Core.csproj" />
  </ItemGroup>
</Project>

